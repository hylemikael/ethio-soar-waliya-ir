# ==============================================================================
# Ethio-SOAR (Waliya-IR) Production Environment Configuration Template
# ==============================================================================
# Copy this template to .env and configure strong, unique secrets for production.
# NEVER commit .env, .env.production, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Mode
# ------------------------------------------------------------------------------
# Options: development, staging, production
WALIYA_ENV=production
WALIYA_LOG_LEVEL=INFO

# Master cryptographic signing key (minimum 32 characters, high entropy)
# Generate with: openssl rand -hex 32
WALIYA_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-char-key

# Administrative API pre-shared key (minimum 16 characters)
# Required for operational health diagnostics and rule administration
# Generate with: openssl rand -hex 24
WALIYA_ADMIN_API_KEY=replace-with-a-secure-admin-api-key-min-16-chars

# Server pepper for hashing agent tokens (minimum 16 characters)
# Generate with: openssl rand -hex 24
WALIYA_AGENT_TOKEN_PEPPER=replace-with-a-random-pepper-min-16-chars

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 18)
# ------------------------------------------------------------------------------
POSTGRES_DB=waliya_ir
POSTGRES_USER=waliya_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# In Docker Compose, the database host is 'postgres'
WALIYA_DATABASE_URL=postgresql+asyncpg://waliya_user:replace-with-a-strong-postgres-password@postgres:5432/waliya_ir

# ------------------------------------------------------------------------------
# 3. Message Stream & Cache (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-strong-redis-password
# In Docker Compose, the redis host is 'redis'
WALIYA_REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0

# Optional: Host port binding for Redis during local dev (default: 6380)
REDIS_HOST_PORT=6380

# ------------------------------------------------------------------------------
# 4. Frontend & Reverse Proxy
# ------------------------------------------------------------------------------
# Host port for the Nginx frontend reverse proxy (default: 8080)
WALIYA_PORT=8080

# Allowed CORS origins (JSON array of explicit URLs, NO wildcards in production)
WALIYA_CORS_ORIGINS=["http://localhost:8080","https://soar.waliya.local"]

# Enforce Secure flag on cookies (MUST be true when serving over HTTPS/TLS)
WALIYA_SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. SOAR Response Engine Timeouts
# ------------------------------------------------------------------------------
WALIYA_COMMAND_TTL_SECONDS=60
WALIYA_VERIFICATION_WINDOW_SECONDS=10

# ------------------------------------------------------------------------------
# 6. External Threat Intelligence Feeds (Optional)
# ------------------------------------------------------------------------------
# TI_THREATFOX_API_KEY=
# TI_URLHAUS_API_KEY=
TI_HTTP_TIMEOUT_SECONDS=30
TI_MAX_RECORDS_PER_SYNC=1000
TI_MIN_SYNC_INTERVAL_MINUTES=15
TI_DEFAULT_EXPIRY_DAYS=30
