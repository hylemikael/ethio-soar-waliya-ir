# ==============================================================================
# Ethio-SOAR (Waliya-IR) Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure strong, unique secrets for production.

WALIYA_ENV=development
WALIYA_LOG_LEVEL=INFO
WALIYA_SECRET_KEY=change-me-to-a-secure-random-key-in-production-min-32-chars
WALIYA_ADMIN_API_KEY=waliya-admin-supersecret-api-key-2026
WALIYA_AGENT_TOKEN_PEPPER=change-me-to-a-random-pepper-in-production-16-chars

# PostgreSQL Connection String (AsyncPG driver)
# Local host dev: 127.0.0.1:5432. Inside Docker Compose: postgres:5432
WALIYA_DATABASE_URL=postgresql+asyncpg://waliya_user:waliya_dev_password@127.0.0.1:5432/waliya_ir

# Redis Streams Connection String
# Local host dev: 127.0.0.1:6380. Inside Docker Compose: redis:6379
WALIYA_REDIS_URL=redis://:waliya_redis_dev_secret@127.0.0.1:6380/0
REDIS_HOST_PORT=6380

# API Security & CORS
WALIYA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]
WALIYA_SESSION_COOKIE_SECURE=false

# SOAR Engine Timeouts
WALIYA_COMMAND_TTL_SECONDS=60
WALIYA_VERIFICATION_WINDOW_SECONDS=10
